# Acceptance workspace — host-native (mise + Playwright + Astro), no Docker, no Java.
node_modules/

# playwright-bdd generated specs (regenerated by `bddgen`)
.features-gen/

# Pinned VS Code download cache (@vscode/test-electron)
.vscode-test/

# Persistent GemStone-release cache for the @download chapter (large; fetched once)
.download-cache/

# Playwright + test artifacts
test-results/
playwright-report/
blob-report/
.cache/

# The Cucumber JSON feed — the data contract between the harness and the manual
# generator. Regenerated on every run; not source.
cucumber-report/

# Acceptance-owned GemStone install + stone (large; cached, reset each run)
.stone-cache/
