---
// A single-page render of the whole manual, for printing to PDF (Playwright
// loads this route and calls page.pdf()). It deliberately bypasses the Starlight
// layout so the PDF is a clean, continuous document. Generated data only.
import type { Manual } from '@engine/model';
import Feature from '@components/Feature.astro';
import manualData from '@generated/manual.json';
import '../styles/manual.css';
import '../styles/print.css';

const manual = manualData as unknown as Manual;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Jasper — User Manual</title>
  </head>
  <body class="print">
    <header class="print-cover">
      <h1>Jasper</h1>
      <p class="print-subtitle">The GemStone/S development environment for VS Code</p>
      <p class="print-tagline">A living manual, generated from the acceptance suite.</p>
      {manual.generatedAt && (
        <p class="print-generated">Generated {new Date(manual.generatedAt).toUTCString()}</p>
      )}
    </header>

    {manual.features.map((feature) => (
      <section class="print-feature">
        <h2>{feature.name}</h2>
        <Feature feature={feature} headingLevel={3} />
      </section>
    ))}
  </body>
</html>
