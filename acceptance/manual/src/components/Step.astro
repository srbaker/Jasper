---
// One Gherkin step: its keyword + text, status, optional docstring/table/error,
// and any screenshots captured during it. Generic.
import type { ManualStep } from '@engine/model';
import StatusBadge from './StatusBadge.astro';
import Screen from './Screen.astro';

interface Props {
  step: ManualStep;
}
const { step } = Astro.props;
---

<li class:list={['step', `step-${step.status}`]}>
  <div class="step-line">
    <span class="step-keyword">{step.keyword}</span>
    <span class="step-text">{step.text}</span>
    {step.durationMs !== undefined && <span class="step-time">{step.durationMs} ms</span>}
    <StatusBadge status={step.status} />
  </div>

  {step.docString && <pre class="step-docstring">{step.docString}</pre>}

  {step.dataTable && (
    <table class="step-datatable">
      <tbody>
        {step.dataTable.map((row) => (
          <tr>{row.map((cell) => <td>{cell}</td>)}</tr>
        ))}
      </tbody>
    </table>
  )}

  {step.error && <pre class="step-error">{step.error}</pre>}

  {step.screenshots.length > 0 && (
    <div class="step-screens">
      {step.screenshots.map((shot) => <Screen screenshot={shot} />)}
    </div>
  )}
</li>
