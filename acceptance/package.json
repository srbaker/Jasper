{
  "name": "jasper-acceptance",
  "version": "0.0.0",
  "private": true,
  "description": "Gherkin-authored, UI-driven acceptance suite for the Jasper VS Code extension whose primary output is a screenshot-rich living-documentation user manual.",
  "type": "commonjs",
  "scripts": {
    "bdd": "bddgen",
    "test": "bddgen && playwright test --grep-invert \"@tricky|@download|@stone|@wip\"",
    "test:tricky": "bddgen && playwright test --grep @tricky",
    "test:download": "bddgen && playwright test --grep @download",
    "test:stone": "bddgen && playwright test --grep @stone --grep-invert @wip",
    "test:docker": "bash scripts/docker-test.sh",
    "test:ci": "xvfb-run -a npm test",
    "manual": "npm --prefix manual run manual",
    "manual:all": "bash scripts/build-manual.sh",
    "manual:docker": "bash scripts/docker-manual.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@vscode/test-electron": "^2.5.2",
    "playwright-bdd": "^9",
    "typescript": "^5.6.0"
  }
}
